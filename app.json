{
  "expo": {
    "name": "Nhật ký ảnh",
    "slug": "photo-diary",
    "scheme": "photodiary",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ECE6DB",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.photodiary.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera là cách nhật ký của bạn sống dậy. Ảnh chỉ lưu trên máy này.",
        "NSLocationWhenInUseUsageDescription": "Ghi lại nơi khoảnh khắc này diễn ra. Vị trí chỉ lưu trên máy này.",
        "NSFaceIDUsageDescription": "Dùng Face ID để mở khoá nhật ký ảnh của bạn."
      }
    },
    "android": {
      "package": "com.photodiary.app",
      "adaptiveIcon": {
        "backgroundColor": "#ECE6DB",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Nhật ký ảnh",
      "shortName": "Nhật ký",
      "lang": "vi",
      "themeColor": "#ECE6DB",
      "backgroundColor": "#ECE6DB",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ECE6DB",
          "image": "./assets/icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-font",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Camera là cách nhật ký của bạn sống dậy. Ảnh chỉ lưu trên máy này.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ghi lại nơi khoảnh khắc này diễn ra. Vị trí chỉ lưu trên máy này."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Dùng Face ID để mở khoá nhật ký ảnh của bạn."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C2402A"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
